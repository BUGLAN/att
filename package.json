{
  "name": "audio-to-text",
  "version": "2.11.2",
  "description": "落墨 — 录音转文字（Tauri 2 + Rust + Vue 3）",
  "scripts": {
    "dev": "vite --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
