    "test:rust": "cd src-tauri && cargo test --workspace",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "vue": "^3.5.45",
    "pinia": "^2.1.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "vite": "^6.4.6"
