# Application
DEBUG=false
APP_NAME="Audio-to-Text API"

# Paths
DATA_DIR=data
MODELS_DIR=models

# Whisper Configuration
ASR_PROVIDER=whisper
ASR_LANGUAGE=zh
ASR_PRELOAD_ON_STARTUP=false
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16

# Qwen3-ASR Configuration
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_DEVICE=auto
QWEN_ASR_DTYPE=auto
QWEN_ASR_MAX_NEW_TOKENS=256
QWEN_ASR_RETURN_TIMESTAMPS=false
QWEN_ASR_USE_FORCED_ALIGNER=false
QWEN_ASR_FORCED_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
QWEN_ASR_MAX_AUDIO_SECONDS=30
QWEN_STREAMING_BACKEND=auto
QWEN_STREAMING_BASE_URL=
# 这两项只被桥接服务脚本读取（scripts/qwen_streaming_service.py），默认 0.85 / 16384
QWEN_STREAMING_GPU_MEMORY_UTILIZATION=0.85
QWEN_STREAMING_MAX_MODEL_LEN=16384
QWEN_STREAMING_TIMEOUT_SECONDS=30

# 火山引擎豆包双向流式 ASR（在线识别，无需本地模型）
# ASR_PROVIDER 可设为 doubao_asr 启用；Access Token 也可以改在「设置 → 语音识别」里填，
# 那条路径会加密落盘到 data/settings.json（doubao_asr_api_key_encrypted），且优先于这里的值。
DOUBAO_ASR_API_KEY=
# ASR 2.0 用 volc.seedasr.sauc.*，1.0 用 volc.bigasr.sauc.*；不匹配会握手 403
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
DOUBAO_ASR_CONNECT_TIMEOUT_SECONDS=10
DOUBAO_ASR_CHUNK_MS=200
# 0 = 跟随服务端语义分段；>0 时按该静音时长（毫秒）输出 definite，实时字幕更早定稿
DOUBAO_ASR_END_WINDOW_SIZE=0
DOUBAO_ASR_FORCE_TO_SPEECH_TIME=0

# Processing
MAX_UPLOAD_SIZE=524288000

# ==================== Docker 部署（docker compose 读取本文件做变量替换） ====================
# 基础镜像：必须与 qwen-asr 锁定的 vllm 版本一致（qwen-asr 0.0.6 锁定 vllm==0.14.0）
VLLM_IMAGE=vllm/vllm-openai:v0.14.0

# 后端映射到宿主的端口（Electron 通过 ATT_BACKEND_PORT 复用该端口）
ATT_BACKEND_PORT=8000

# 流式桥接服务地址：
#   容器部署由 docker-compose.yml 强制注入 http://asr:9000，无需在此配置
#   本地原生运行（npm run qwen:streaming:uv）时留空，后端会自行拉起本地子进程
# QWEN_STREAMING_BASE_URL 已在上面定义，此处不再重复

# 流式模型（供 ASR 容器内的桥接服务读取）
QWEN_STREAMING_MODEL=Qwen/Qwen3-ASR-1.7B

# 流式分块参数（延迟调优，对应决策 D5）：
#   CHUNK_SIZE_SEC 越小延迟越低，但推理更频繁、精度可能略降
#   2.0 为上游库默认值（已知稳定）；压延迟实验建议从 1.0 起测，并用基准脚本验证
QWEN_STREAMING_CHUNK_SIZE_SEC=2.0
QWEN_STREAMING_UNFIXED_CHUNK_NUM=2
QWEN_STREAMING_UNFIXED_TOKEN_NUM=5

# 预热时是否同时完成 vLLM 引擎预热（默认 1 开启）
# 开启后 /api/preload 会多花约 30 秒完成首次编译，但第一次录音不再卡顿
# 关闭（0）会让首次录音替你承受这段开销
QWEN_STREAMING_WARMUP=1

# 容器启动后是否自动预热模型（默认 1 开启）
# 保证「容器起来 = 流式可用」，也让容器被 Docker Desktop 自动重启后仍能自愈
# 关闭（0）时模型需由启动脚本或前端「开启模型」按钮触发加载
QWEN_STREAMING_AUTO_PRELOAD=1


# Note: LLM API configuration (DeepSeek, Claude, OpenAI, etc.)
# should be done through the web UI at Settings > LLM Provider
