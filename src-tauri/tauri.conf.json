{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio to Text",
  "version": "2.0.0",
  "identifier": "com.att.audio-to-text",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:8090",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../prompts/": "prompts/"
    }
  }
}
