{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "落墨",
  "version": "2.9.0",
  "identifier": "com.att.audio-to-text",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:8090",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; media-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../prompts/": "prompts/"
    },
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "7d1c25af-2d66-5be0-b96a-72ebab18ea36"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBODAzNjFDNkY0RDg3MzcKUldRM2gwMXZIRGFBYXBpelN2RFQ2Vkd4UkpuVXpXVWQrdXJPWExXdlB1aVJvWis4QXJBaGdsck4K",
      "endpoints": [
        "https://github.com/BUGLAN/att/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
