{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "落墨",
  "version": "2.5.0",
  "identifier": "com.att.audio-to-text",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:8090",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../prompts/": "prompts/"
    },
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "7d1c25af-2d66-5be0-b96a-72ebab18ea36"
      }
    }
  }
}
