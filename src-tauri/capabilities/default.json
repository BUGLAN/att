{
  "$schema": "https://schema.tauri.app/acl/capability",
  "identifier": "default",
  "description": "主窗口、录音悬浮窗与剪贴板悬浮框的默认能力：核心 API 与标题栏拖动（自定义命令不受 ACL 限制）",
  "windows": [
    "main",
    "floating",
    "clipboard-panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging"
  ]
}
